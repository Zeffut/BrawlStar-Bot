[match]
enabled = false
template = """{emoji} {result_upper} — {brawler}
Trophies: {before} → {after} ({sign}{delta})
Match {match_n} • W/L/D {wins}/{losses}/{draws} ({wr:.0f}% WR)
Session: {session_sign}{session_delta} trophies • Target {target}"""

[match.filter]
victory = true
defeat = true
draw = true

[target_reached]
enabled = true
template = "🎯 Cible atteinte : {trophies}/{target} 🏆 (dernier brawler joué : {brawler})"

[cycle_started]
enabled = false
template = """📊 Starting cycle on {brawler}
Current: {current} trophies → Target: {target}
Need: {needed} more"""

[cycle_started_no_ocr]
enabled = false
template = "⚠️ Could not read current trophies for {brawler}. Cycle started — target {target}."

[stop_during_init]
enabled = false
template = "🛑 Bot stopped during init (no match started)."

# A healthy cycle (match + brawler-swap selection + post-match screens) can
# legitimately run ~12 min between two match-ends, so the alert only fires
# past that to avoid false "bloqué" notifications. Silent goto_lobby recovery
# already kicks in at 12 min; hard worker restart at 18 min.
[bot_stuck]
enabled = true
threshold_minutes = 13
template = """⚠️ Bot semble bloqué
Aucun match terminé depuis {minutes} min.
Brawler en cours: {brawler} — {matches} matches dans cette session.
Le bot tente une récupération automatique vers le lobby."""

[battery_low]
enabled = true
template = "🔋 Batterie faible — bot en pause (reprend à 75%)."

[battery_resumed]
enabled = false
template = "⚡ Batterie OK — bot reprend."

[session_ended]
enabled = false
template = """🏁 Session terminée
{matches} matches • W/L/D {wins}/{losses}/{draws}
Trophies: {start_trophies} → {end_trophies} ({delta:+d})"""
